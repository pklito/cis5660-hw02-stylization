    "m_FunctionBody": "#define HASH(p) frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453)\r\n\r\nfloat value = 0.0;\r\nfloat amplitude = 0.5;\r\nfloat2 freq = UV;\r\n\r\nfor (int n = 0; n < (int)Octaves; n++)\r\n{\r\n    float2 i = floor(freq);\r\n    float2 f = frac(freq);\r\n    float2 u = f * f * (3.0 - 2.0 * f);\r\n\r\n    float a = HASH(i);\r\n    float b = HASH(i + float2(1.0, 0.0));\r\n    float c = HASH(i + float2(0.0, 1.0));\r\n    float d = HASH(i + float2(1.0, 1.0));\r\n\r\n    value += amplitude * lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);\r\n\r\n    freq *= Lacunarity;\r\n    amplitude *= Gain;\r\n}\r\n\r\nOut = value;"
}

